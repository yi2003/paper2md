# Paper2MD configuration. Copy to `.env` and edit.

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Only used when IMAGE_HOST=local. Set it to your machine's LAN IP (e.g.
# http://192.168.1.20:8000) if the markdown has to work on another device.
PUBLIC_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------------
# Where extracted figures are hosted: imgbb | local | base64
#   imgbb  - upload to imgbb.com and reference the public URL (default)
#   local  - reference this app's own /tasks/<id>/images/<file> URL (offline)
#   base64 - inline every figure into the markdown, one self-contained file
# --------------------------------------------------------------------------
IMAGE_HOST=imgbb
# Free key from https://api.imgbb.com/ . Without a key, figures are inlined
# as base64 instead.
IMGBB_API_KEY=
# Seconds until ImgBB expires the image; 0 keeps it forever.
IMGBB_EXPIRATION=0

# --------------------------------------------------------------------------
# OCR
# --------------------------------------------------------------------------
# Longest edge of the image handed to the model. Lower = faster, less accurate.
OCR_MAX_DIM=1536
# Pages processed in parallel. All share one model, so this costs almost no
# extra RAM. Measured on 16 cores: 1 -> 12 chars/s, 3 -> 28, 6 -> 38.
# Rule of thumb: set it to about a third of your CPU cores.
OCR_WORKERS=4
# Native threads per inference. 1 is fastest here; parallelism comes from
# OCR_WORKERS, not from giving each page every core.
OCR_THREADS=1
# oneDNN acceleration. Leave off unless your Paddle build supports it.
OCR_ENABLE_MKLDNN=0
OCR_PIPELINE_VERSION=v1.6
# 1 = print full tracebacks for failed pages.
OCR_DEBUG=0

# --------------------------------------------------------------------------
# DeepSeek — optional cleanup pass
# --------------------------------------------------------------------------
# OCR of a real exam paper reads the student's handwritten answers as if they
# were part of the question (e.g. "则 $x+y=\underline{5}$"). With a key set, the
# review screen gains a "Clean up" button that sends the paper to DeepSeek and
# returns the printed questions only, with every figure kept.
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Verified against GET /models on first use; falls back if your account lacks it.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=600
# Papers longer than this are cleaned page by page instead of in one call.
DEEPSEEK_MAX_CHARS=24000

# --------------------------------------------------------------------------
# Uploads
# --------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PAGES_PER_UPLOAD=50
